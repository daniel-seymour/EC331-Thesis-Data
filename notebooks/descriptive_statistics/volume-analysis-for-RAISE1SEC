    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import s3fs\n",
    "import pyarrow.parquet as pq\n",
    "import pyarrow.feather as feather\n",
    "import io\n",
    "\n",
    "# S3 base path\n",
    "s3_base_path = \"thesis--ec331-s3/dispatch-data/\"\n",
    "fs = s3fs.S3FileSystem()\n",
    "\n",
    "# List all files (parquet + feather)\n",
    "files = fs.ls(s3_base_path)\n",
    "parquet_files = [f for f in files if f.endswith(\".parquet\")]\n",
    "feather_files = [f for f in files if f.endswith(\".feather\")]\n",
    "\n",
    "print(f\"Found {len(parquet_files)} Parquet files and {len(feather_files)} Feather files.\")\n",
    "\n",
    "# Read all data into a single DataFrame\n",
    "df_list = []\n",
    "\n",
    "# Read Parquet files\n",
    "for file in parquet_files:\n",
    "    print(f\"Reading Parquet: {file}\")\n",
    "    with fs.open(file, 'rb') as f:\n",
    "        df = pd.read_parquet(f, engine='pyarrow')\n",
    "        df_list.append(df)\n",
    "\n",
    "# Read Feather files\n",
    "for file in feather_files:\n",
    "    print(f\"Reading Feather: {file}\")\n",
    "    with fs.open(file, 'rb') as f:\n",
    "        buffer = io.BytesIO(f.read())\n",
    "        df = pd.read_feather(buffer)\n",
    "        df_list.append(df)\n",
    "\n",
    "# Combine all into a single DataFrame\n",
    "df_all = pd.concat(df_list, ignore_index=True)\n",
    "print(f\"Combined DataFrame shape: {df_all.shape}\")"
   ]
